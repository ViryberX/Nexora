# ====================================================
# NEXORA AI — Environment Variables Template
# ====================================================
# How to use:
# 1. Copy this file to .env:
#      cp .env.example .env
# 2. Fill in your Gemini and Tavily API keys below.
# 3. Start the application:
#      npm run dev
#
# NOTE: Never commit your actual .env file to GitHub!
# ====================================================

# ----------------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------------
PORT=3001
NODE_ENV=development

# ----------------------------------------------------
# AI & LLM PROVIDER (Google Gemini)
# ----------------------------------------------------
# Get your free API key at: https://aistudio.google.com/app/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended model: gemini-3.6-flash (Fast, cost-efficient, 1M context)
# Sibling fallback models handled automatically: gemini-3.7-flash, gemini-3.5-flash
GEMINI_MODEL=gemini-3.6-flash

# ----------------------------------------------------
# SEARCH PROVIDER (Tavily AI Search)
# ----------------------------------------------------
# Get your free API key at: https://tavily.com/ (Free tier: 1,000 searches/month)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here

# ----------------------------------------------------
# SECURITY & AUTHENTICATION
# ----------------------------------------------------
# Replace with any secure secret string for JWT signing
JWT_SECRET=your_jwt_secret_key_change_in_production

# ----------------------------------------------------
# DATABASE
# ----------------------------------------------------
# Local SQLite development database (default):
DATABASE_URL="file:./dev.db"

# Production PostgreSQL (uncomment if deploying with PostgreSQL):
# DATABASE_URL="postgresql://username:password@host:5432/nexora?schema=public"

# ----------------------------------------------------
# FRONTEND CONFIGURATION (Optional)
# ----------------------------------------------------
# If the frontend is hosted separately from the Express backend, specify backend URL:
# VITE_API_URL=http://localhost:3001
